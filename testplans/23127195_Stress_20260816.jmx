            <stringProp name="HTTPSampler.path">/api/login</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract jwt + userId" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">jwt;userId</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.token;$.user.id</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1;1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">TOKEN_NOT_FOUND;0</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert login + phan biet 401 / 403 lockout" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// Phan biet ro 3 tinh huong hong cua buoc login.
// Neu chi assert "response code = 200" thi khi doc .jtl se khong biet
// tai khoan hong vi sai mat khau (401) hay vi da bi khoa 180s (403).
String code = prev.getResponseCode()
if (code == "200") {
    if (!prev.getResponseDataAsString().contains("token")) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage("LOGIN_NO_TOKEN: HTTP 200 nhung body khong co truong token")
    }
} else if (code == "403") {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("LOCKOUT_403: tai khoan " + vars.get("email") + " dang bi khoa (server.js khoa 180s sau 2 lan sai)")
} else if (code == "401") {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("AUTH_401: sai credential cho " + vars.get("email") + " - kiem tra lai seed_users.js")
} else {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("LOGIN_HTTP_" + code)
}</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
        </hashTree>
