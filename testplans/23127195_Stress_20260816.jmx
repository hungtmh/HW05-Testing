            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Tinh total_amount (chuan hoa kieu price)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// server.js:162 tra price ve dang CHUOI khi product id chan, dang SO khi id le.
// Chuan hoa ve so truoc khi nhan voi quantity de tranh loi kieu du lieu.
String raw = vars.get("price")
String digits = (raw == null) ? "" : raw.replaceAll("[^0-9]", "")
long p = digits.isEmpty() ? 1000000L : Long.parseLong(digits)
int q = 1
try { q = Integer.parseInt(vars.get("quantity")) } catch (Exception e) { q = 1 }
long total = p * q
// Coupon BIGBUY yeu cau min_order_amount = 500000, VIP100 yeu cau 300000.
// Ep san toi thieu 600000 de buoc apply-coupon di vao nhanh tinh giam gia thuc su.
total = Math.max(total, 600000L)
vars.put("total_amount", String.valueOf(total))</stringProp>
            </JSR223PostProcessor>
